#syntax=docker/dockerfile:1

# AMX Mod X compiler (amxxpc) plus the CoD Mod include files.
#
# amxxpc is a 32-bit ELF binary, so the image installs the i386 runtime.
FROM debian:bookworm-slim

ARG AMXX_VERSION=1.10.0-git5479
ARG AMXX_BASE_URL=https://www.amxmodx.org/amxxdrop/1.10

RUN dpkg --add-architecture i386 \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		lib32stdc++6 \
		libc6:i386 \
		libgcc-s1:i386 \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /opt/amxmodx

RUN curl -fsSL "${AMXX_BASE_URL}/amxmodx-${AMXX_VERSION}-base-linux.tar.gz" | tar xz \
	&& curl -fsSL "${AMXX_BASE_URL}/amxmodx-${AMXX_VERSION}-cstrike-linux.tar.gz" | tar xz

ENV AMXX_SCRIPTING=/opt/amxmodx/addons/amxmodx/scripting
ENV PATH="${AMXX_SCRIPTING}:${PATH}"

WORKDIR /src

COPY compile.sh /usr/local/bin/compile.sh
RUN chmod +x /usr/local/bin/compile.sh

ENTRYPOINT ["/usr/local/bin/compile.sh"]
